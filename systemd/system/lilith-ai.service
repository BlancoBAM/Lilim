[Unit]
Description=Lilim AI Assistant Runtime (Rust Proxy & Python Brain)
After=network.target
Wants=network.target

[Service]
Type=simple
# NOTE: Recommended deployment uses the template unit lilith-ai@.service
# e.g., systemctl enable --now lilith-ai@<username>.service
# For single-user install, replace %i with your username.
User=%i
Group=%i
WorkingDirectory=/home/%i
ExecStart=/usr/bin/lilim-runtime
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=30

Environment=LILIM_INSTALL=/usr/lib/lilim
Environment=LILIM_VENV=/usr/lib/lilim/venv
Environment=PYTHONUNBUFFERED=1
Environment=RUST_LOG=lilim_runtime=info,lilim_inference=info

# Safe security directives (no namespace requirements)
NoNewPrivileges=yes

# Resource limits
MemoryMax=4G
MemoryHigh=3.5G
TasksMax=1024

[Install]
WantedBy=multi-user.target
