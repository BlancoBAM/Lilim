[Unit]
Description=Lilim AI Assistant Runtime (Rust Proxy & Python Brain)
After=network.target
Wants=network.target

[Service]
Type=simple
# User/Group/WorkingDirectory/HOME are patched to the real account at install time.
# The install script replaces LILIM_USER_PLACEHOLDER with the actual username.
User=LILIM_USER_PLACEHOLDER
Group=LILIM_USER_PLACEHOLDER
WorkingDirectory=/home/LILIM_USER_PLACEHOLDER
ExecStart=/usr/bin/lilim-runtime
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

Environment=HOME=/home/LILIM_USER_PLACEHOLDER
Environment=LILIM_INSTALL=/usr/lib/lilim
Environment=LILIM_VENV=/usr/lib/lilim/venv
Environment=PYTHONUNBUFFERED=1
Environment=RUST_LOG=lilim_runtime=info,lilim_inference=info

# Safe security directives
NoNewPrivileges=yes

# Resource limits — tuned for Phi-3.5-mini local inference
MemoryMax=6G
MemoryHigh=5G
TasksMax=1024

[Install]
WantedBy=multi-user.target
