[Unit]
Description=Lilim AI Assistant Runtime (Rust Proxy & Python Brain)
After=network.target
Wants=network.target

[Service]
Type=simple
# Do NOT hardcode a user here — use "User=%i" when installed as a system template,
# or install as a user service: systemctl --user enable lilith-ai.service
# For a plain system service, set User= to the primary account or remove it
# so systemd derives it from the calling user via PAM on session login.
User=%i
Group=%i
WorkingDirectory=/home/%i
ExecStart=/usr/bin/lilim-runtime
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=30

# Let the runtime derive HOME/USER from the service user, not hardcoded values.
# These are set automatically by systemd when User= is set correctly.
Environment=LILIM_INSTALL=/usr/lib/lilim
Environment=LILIM_VENV=/usr/lib/lilim/venv
Environment=PYTHONUNBUFFERED=1
Environment=RUST_LOG=lilim_runtime=info,lilim_inference=info

# Safe security directives (no namespace requirements)
NoNewPrivileges=yes

# Resource limits
MemoryMax=4G
MemoryHigh=3.5G
TasksMax=1024

[Install]
WantedBy=multi-user.target
